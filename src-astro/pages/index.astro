---
import '../styles/global.css';

const formats = [
  // ---------- READ ----------
  { icon: '📄', title: 'Traditional PDF', desc: 'ATS-friendly, print-ready professional format. Clean layout, proper headings, downloadable.', href: '/output/cv-michael-borck.pdf', badges: ['Classic', 'Print'], group: 'read' },
  { icon: '🌐', title: 'Traditional HTML', desc: 'Responsive web version with clean styling, table of contents, and an embedded chat widget.', href: '/output/cv-michael-borck.html', badges: ['Web', 'Responsive'], group: 'read' },
  { icon: '📃', title: 'Plain text', desc: 'The CV as plain text (llms.txt) — no styling, just the words, for reading or pasting anywhere.', href: '/llms.txt', badges: ['Plain Text'], group: 'read' },
  { icon: '📰', title: 'TechLife Magazine', desc: 'Magazine-style layout with pull quotes and editorial design. My career as feature articles.', href: '/creative/magazine/', badges: ['Visual', 'Editorial'], group: 'read' },
  { icon: '📈', title: 'Gantt chart', desc: 'Roles over time as a Gantt chart — hover any bar or label for the role, dates and responsibilities.', href: '/creative/gantt/', badges: ['Timeline', 'Hover'], group: 'read' },
  { icon: '📊', title: 'Dashboard', desc: 'A dashboard of charts — time by role, skills, roles active per year, publications — hover for detail, click to filter.', href: '/creative/dashboard/', badges: ['Charts', 'Hover'], group: 'read' },
  { icon: '🗂️', title: 'Trello board', desc: 'The career as a Trello-style board — drag cards between lists, add your own notes, click a card for detail.', href: '/creative/trello/', badges: ['Board', 'Drag'], group: 'read' },

  // ---------- PLAY ----------
  { icon: '🗺️', title: 'Resume World', desc: 'Zelda-style pixel-art overworld. Explore regions of a career — the Keep, the Dojo, the Observatory — and discover the story behind every place.', href: '/creative/world/', badges: ['Interactive', 'Pixel Art'], group: 'play' },
  { icon: '🍄', title: "Michael Borck's World", desc: 'A Super-Mario-World-style level select. Walk the paths between career levels, enter them, and clear them all to reach the castle.', href: '/creative/mario/', badges: ['Overworld', 'Levels'], group: 'play' },
  { icon: '💀', title: 'Resume Doom', desc: 'A Doom-style first-person shooter. Blast barrels for skills, crack chests for education and projects, and put down the demons — his jobs.', href: '/creative/doom/', badges: ['FPS', 'Raycaster'], group: 'play' },
  { icon: '🕯️', title: 'The Delve', desc: 'A roguelike text dungeon. Procedural depths, turn-based combat, potions and relics — fight career monsters and reach the Archive before you die.', href: '/creative/dungeon/', badges: ['Roguelike', 'Text'], group: 'play' },
  { icon: '📖', title: 'The Valley', desc: 'A branching interactive-fiction resume written in Ink. Walk eight places of a working life and reach the ending.', href: '/creative/ink/', badges: ['Ink', 'Fiction'], group: 'play' },
  { icon: '⛏️', title: 'MineBorck', desc: 'A blocky isometric voxel world. Dig through the island to uncover golden ore blocks, each holding a fact about a career. Or build.', href: '/creative/voxel/', badges: ['Voxel', 'Dig/Build'], group: 'play' },
  { icon: '🎮', title: 'CV Quest', desc: 'Retro 8-bit swipe card adventure. Explore my career through a playful card game.', href: '/creative/quest/', badges: ['Interactive', 'Game'], group: 'play' },
  { icon: '🖥️', title: 'Terminal Adventure', desc: 'Zork-style text adventure through my career. Type commands to explore experience and skills.', href: '/creative/terminal/', badges: ['Interactive', 'CLI'], group: 'play' },

  // ---------- LEARN ----------
  { icon: '🎤', title: 'Slides (Reveal.js)', desc: 'HTML5 presentation. Navigate a career as a slide deck — arrow keys, presenter-friendly.', href: '/output/cv-michael-borck-slides.html', badges: ['Slides', 'Reveal.js'], group: 'read' },
  { icon: '🖼️', title: 'Slides (deck-engine)', desc: 'The CV as a dependency-free deck-engine deck: chapter rail, speaker notes, presenter mode, timer.', href: '/creative/slides-deck/deck.html', badges: ['Slides', 'deck-engine'], group: 'read' },
  { icon: '❓', title: 'Quiz', desc: 'A replayable multiple-choice quiz — ten random questions from the CV, marked instantly.', href: '/creative/quiz/', badges: ['Quiz', 'Replayable'], group: 'learn' },
  { icon: '🃏', title: 'Flashcards', desc: 'Flip-card flashcards for study. Shuffle, flip, and print.', href: '/creative/flashcards/', badges: ['Study', 'Print'], group: 'learn' },
  { icon: '🕸️', title: 'Mindmap', desc: 'The whole career on one page as an SVG mindmap — experience, education, skills, projects, teaching, interests.', href: '/creative/mindmap/', badges: ['Mindmap', 'Visual'], group: 'learn' },
  { icon: '🧑‍🏫', title: 'Lesson plan', desc: 'A 60-minute BOPPPS workshop using this site as the case study — objectives, timed activities, checks, UDL and a GenAI statement.', href: '/creative/lesson-plan/', badges: ['Teaching', 'BOPPPS'], group: 'learn' },
  { icon: '📊', title: 'Infographic', desc: 'A one-page visual CV: headline stats, skills by volume, timeline, education and projects. Printable.', href: '/creative/infographic/', badges: ['Visual', 'Print'], group: 'learn' },
  { icon: '🎴', title: 'Printable cards', desc: 'A deck of 24 career cards — roles, degrees, projects, books — laid out for A4 printing with cut lines.', href: '/creative/cards/', badges: ['Cards', 'Print'], group: 'learn' },
  { icon: '🎧', title: 'Podcast', desc: 'A two-host podcast script of the career, ready to record or generate as audio via NotebookLM.', href: '/creative/podcast/', badges: ['Audio', 'Script'], group: 'learn' },
  { icon: '🎬', title: 'Narrated video', desc: 'A slide-stream Markdown source that renders to a narrated MP4 or PowerPoint.', href: '/creative/videos/', badges: ['Video', 'slide-stream'], group: 'learn' },

  // ---------- USE ----------
  { icon: '⚡', title: 'Live API', desc: 'Real FastAPI backend serving my resume as structured JSON with interactive Swagger docs.', href: 'https://api.resume.borck.dev/docs', badges: ['Live', 'FastAPI'], group: 'use' },
  { icon: '🤖', title: 'MCP Server', desc: 'Model Context Protocol server for Claude and other AI assistants. Query my resume from your AI tools.', href: 'https://www.npmjs.com/package/@michaelborck/resume-mcp-server', badges: ['AI', 'MCP'], group: 'use' },
  { icon: '📋', title: 'llms.txt', desc: 'Plain-text resume optimised for LLM ingestion. Like robots.txt but for AI assistants.', href: '/llms.txt', badges: ['AI', 'Plain Text'], group: 'use' },
  { icon: '🗄️', title: 'Data exports', desc: 'Download the CV as Markdown, Quarto, LaTeX, JSON, XML, CSV, a Python dict, or MySQL (schema + dump).', href: '/creative/data/', badges: ['Data', 'Downloads'], group: 'use' },
  { icon: '🔗', title: 'SwipeVerse deck', desc: 'The career exported as a portable SwipeVerse Reality — open it straight in swipeverse.app with a deep link.', href: '/creative/swipeverse/', badges: ['Cross-app', 'Deck'], group: 'use' },
  { icon: '📚', title: 'Knotebook pack', desc: 'The Valley Ink story as a self-contained .knotebook.json pack, artwork embedded — import and play offline.', href: '/creative/knotebook/', badges: ['Cross-app', 'Ink'], group: 'use' },
  { icon: '🔌', title: 'API Documentation', desc: 'A mock Swagger-style REST interface — browse the CV as if it were API endpoints.', href: '/creative/api/', badges: ['Mock API', 'Read'], group: 'read' },
  { icon: '📦', title: 'The Source', desc: 'One YAML file generates everything above. One edit, every format updated.', href: 'https://github.com/michael-borck/resume.borck.dev/blob/main/data/cv-data.yml', badges: ['YAML', 'Source'], group: 'use' },
  { icon: '⚙️', title: 'How It Works', desc: 'How it works: YAML → generators → build. Software, licences, acknowledgements and future work.', href: '/credits', badges: ['Pipeline', 'Licences'], group: 'use' },
];

const read = formats.filter((f) => f.group === 'read');
const play = formats.filter((f) => f.group === 'play');
const learn = formats.filter((f) => f.group === 'learn');
const use = formats.filter((f) => f.group === 'use');
const meta = new Set(['The Source', 'How It Works']);
const exploreCount = formats.filter((f) => !meta.has(f.title)).length;
const ext = (href) => href.startsWith('http');

// Footer "Elsewhere" band — sites I run (grouped) + external profiles I don't.
const hubGroups = [
  { name: 'Education', links: [
    { label: 'borck.education', url: 'https://borck.education' },
    { label: 'tools', url: 'https://tools.borck.education' },
    { label: 'simulations', url: 'https://simulations.borck.education' },
    { label: 'books', url: 'https://books.borck.education' },
    { label: 'teach', url: 'https://teach.borck.education' },
    { label: 'research', url: 'https://research.borck.dev' },
  ]},
  { name: 'Build', links: [
    { label: 'borck.dev', url: 'https://borck.dev' },
    { label: 'Lesson Loom', url: 'https://lessonloom.borck.education' },
    { label: 'SlideStream', url: 'https://slidestream.borck.education' },
    { label: 'Knotebook', url: 'https://knotebook.borck.education' },
    { label: 'deck-engine', url: 'https://deck-engine.borck.dev' },
  ]},
  { name: 'Practice', links: [
    { label: 'borck.consulting', url: 'https://borck.consulting' },
    { label: '8020workshop', url: 'https://8020workshop.com' },
    { label: 'retroverse.studio', url: 'https://retroverse.studio' },
    { label: 'LocoLabo', url: 'https://locolabo.org' },
  ]},
];
const elsewhere = [
  { label: 'LinkedIn', url: 'https://linkedin.com/in/michaelborck' },
  { label: 'GitHub', url: 'https://github.com/michael-borck' },
  { label: 'Google Scholar', url: 'https://scholar.google.com/citations?user=fwNMowoAAAAJ&hl=en' },
  { label: 'ORCID', url: 'https://orcid.org/0000-0002-0950-6396' },
  { label: 'ResearchGate', url: 'https://www.researchgate.net/profile/Michael-Borck' },
  { label: 'Academia', url: 'https://curtin.academia.edu/MichaelBorck' },
  { label: 'about.me', url: 'https://about.me/michaelborck' },
  { label: 'X', url: 'https://x.com/Michael_Borck' },
  { label: 'YouTube', url: 'https://www.youtube.com/@8020workshop' },
  { label: 'Facebook', url: 'https://www.facebook.com/michael.borck/' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>resume.borck.dev</title>
  <meta name="description" content={`One YAML file, ${exploreCount} ways to explore it — Michael Borck's interactive resume.`} />
  <link rel="icon" href="/favicon.svg" />
  <style>
    .builtwith { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; align-items: center; margin: 18px 0 10px; }
    .builtwith .bw-label { font-family: var(--mono); font-size: 0.7rem; color: var(--gray-1); letter-spacing: 1px; text-transform: uppercase; margin-right: 4px; }
    .builtwith a { font-family: var(--mono); font-size: 0.72rem; color: var(--text); border: 1px solid var(--gray-3); border-radius: 999px; padding: 4px 10px; text-decoration: none; }
    .builtwith a:hover { border-color: var(--accent); color: var(--accent-high); }
    .builtwith .bw-credits { border-color: var(--accent); color: var(--accent-high); }
    .elsewhere { border-top: 1px solid var(--gray-3); margin-top: 8px; padding: 26px 2rem 8px; }
    .ex-inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1.4fr 1fr; gap: 28px; }
    @media (max-width: 820px) { .ex-inner { grid-template-columns: 1fr; } }
    .ex-title { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 1.2px; text-transform: uppercase; color: var(--gray-1); margin-bottom: 10px; }
    .ex-group { display: flex; gap: 10px; align-items: flex-start; margin-bottom: 8px; }
    .ex-label { font-family: var(--mono); font-size: 0.66rem; color: var(--accent); text-transform: uppercase; letter-spacing: 0.5px; min-width: 74px; padding-top: 5px; }
    .ex-pills { display: flex; flex-wrap: wrap; gap: 6px; }
    .ex-pill { font-family: var(--mono); font-size: 0.72rem; color: var(--text); border: 1px solid var(--gray-3); border-radius: 999px; padding: 4px 10px; text-decoration: none; }
    .ex-pill:hover { border-color: var(--accent); color: var(--accent-high); }
    .ex-note { font-family: var(--mono); font-size: 0.65rem; color: var(--gray-2); margin-top: 8px; }
  </style>
</head>
<body>

<div class="topbar">
  <a class="topbar-logo" href="/">resume<span class="dot">.</span><span class="sub">borck.dev</span></a>
  <div class="topbar-spacer"></div>
  <nav class="topbar-links">
    <a href="https://borck.education" title="Tools, books, and teaching for educators and students">Education</a>
    <a href="https://research.borck.dev" title="Academic research, papers, and HCI work">Research</a>
    <a href="https://borck.dev" title="Builder, educator, researcher, and consultant">borck.dev</a>
  </nav>
</div>

<section class="hero">
  <h1 class="hero-title">One YAML file,<br><span class="accent">{exploreCount} ways</span> to explore it.</h1>
  <p class="hero-sub">Michael Borck — educator, builder, researcher.</p>
  <div class="hero-ctas">
    <a class="btn btn-solid" href="/output/cv-michael-borck.pdf">Download PDF</a>
    <a class="btn btn-ghost" href="/creative/mario/">Walk the world ›</a>
  </div>
</section>

<main class="tiers">

  <section class="tier" style="animation-delay: 0ms">
    <header class="tier-head">
      <span class="tier-num">01</span>
      <h2 class="tier-title">Read it</h2>
      <span class="tier-rule"></span>
      <p class="tier-sub">the traditional CV, for humans in a hurry</p>
    </header>
    <div class="row-list">
      {read.map((f) => (
        <a class="row" href={f.href} target={ext(f.href) ? '_blank' : undefined} rel={ext(f.href) ? 'noopener' : undefined}>
          <span class="row-icon">{f.icon}</span>
          <span class="row-text">
            <span class="row-title">{f.title}</span>
            <span class="row-desc">{f.desc}</span>
          </span>
          <span class="row-arrow">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="tier" style="animation-delay: 100ms">
    <header class="tier-head">
      <span class="tier-num">02</span>
      <h2 class="tier-title">Play it</h2>
      <span class="tier-rule"></span>
      <p class="tier-sub">the same career, many unexpected skins</p>
    </header>
    <div class="feature-grid">
      {play.map((f) => (
        <a class="feature" href={f.href} target={ext(f.href) ? '_blank' : undefined} rel={ext(f.href) ? 'noopener' : undefined}>
          <span class="feature-icon">{f.icon}</span>
          <span class="feature-title">{f.title}</span>
          <span class="feature-desc">{f.desc}</span>
          <span class="feature-badges">
            {f.badges.map((b) => <span class="badge">{b}</span>)}
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="tier" style="animation-delay: 200ms">
    <header class="tier-head">
      <span class="tier-num">03</span>
      <h2 class="tier-title">Learn it</h2>
      <span class="tier-rule"></span>
      <p class="tier-sub">slides, quizzes and study aids — for teaching &amp; learning</p>
    </header>
    <div class="row-list">
      {learn.map((f) => (
        <a class="row" href={f.href} target={ext(f.href) ? '_blank' : undefined} rel={ext(f.href) ? 'noopener' : undefined}>
          <span class="row-icon">{f.icon}</span>
          <span class="row-text">
            <span class="row-title">{f.title}</span>
            <span class="row-desc">{f.desc}</span>
          </span>
          <span class="row-arrow">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="tier" style="animation-delay: 300ms">
    <header class="tier-head">
      <span class="tier-num">04</span>
      <h2 class="tier-title">Use it</h2>
      <span class="tier-rule"></span>
      <p class="tier-sub">for developers, AI assistants &amp; other apps</p>
    </header>
    <div class="chip-grid">
      {use.map((f) => (
        <a class="chip" href={f.href} target={ext(f.href) ? '_blank' : undefined} rel={ext(f.href) ? 'noopener' : undefined}>
          <span class="chip-head"><span class="chip-dollar">$</span> {f.title.toLowerCase()}</span>
          <span class="chip-desc">{f.desc}</span>
        </a>
      ))}
    </div>
  </section>

</main>

<section class="elsewhere" aria-labelledby="elsewhere-title">
  <div class="ex-inner">
    <div class="ex-col">
      <h2 id="elsewhere-title" class="ex-title">Hubs I run</h2>
      {hubGroups.map((g) => (
        <div class="ex-group">
          <span class="ex-label">{g.name}</span>
          <span class="ex-pills">
            {g.links.map((l) => <a class="ex-pill" href={l.url} target="_blank" rel="noopener">{l.label}</a>)}
          </span>
        </div>
      ))}
    </div>
    <div class="ex-col">
      <h2 class="ex-title">Elsewhere on the web</h2>
      <div class="ex-pills">
        {elsewhere.map((l) => <a class="ex-pill" href={l.url} target="_blank" rel="noopener">{l.label}</a>)}
      </div>
      <p class="ex-note">External profiles — sites I don't run.</p>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="footer-links">
    <a href="https://linkedin.com/in/michaelborck">LinkedIn</a>
    <a href="https://borck.dev">borck.dev</a>
    <a href="/credits">Credits &amp; how it works</a>
  </div>
  <div class="builtwith">
    <span class="bw-label">Built with</span>
    <a href="https://astro.build">Astro</a>
    <a href="https://quarto.org">Quarto</a>
    <a href="https://revealjs.com">Reveal.js</a>
    <a href="https://github.com/inkle/inkjs">inkjs</a>
    <a href="https://github.com/michael-borck/deck-engine">deck-engine</a>
    <a href="https://slidestream.borck.education">SlideStream</a>
    <a href="https://lessonloom.borck.education">Lesson Loom</a>
    <a href="https://github.com/michael-borck/playable-lessons">playable-lessons</a>
    <a href="https://knotebook.borck.education">Knotebook</a>
    <a href="https://swipeverse.app">SwipeVerse</a>
    <a href="/credits" class="bw-credits">Credits &amp; licences →</a>
  </div>
  <p>Michael Borck · Perth, WA · <a href="mailto:hello@borck.dev">hello@borck.dev</a></p>
</footer>

</body>
</html>